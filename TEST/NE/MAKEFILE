all : T01.EXE T03.EXE T05.EXE

T01.EXE: T01.RDF T02.RDF ..\..\BIN\RLINK.EXE
	..\..\BIN\RLINK ne /o=T01.EXE T01.RDF T02.RDF
T03.EXE: T03.RDF ..\..\BIN\RLINK.EXE
	..\..\BIN\RLINK ne /o=T03.EXE T03.RDF
T05.EXE: T01.RDF T02.RDF T05.DEF R01.RES ..\..\BIN\RLINK.EXE
	..\..\BIN\RLINK ne /def=T05.DEF /res=R01.RES /o=T05.EXE T01.RDF T02.RDF
R01.RES: R01.ASM
	nasm -f bin R01.ASM -o R01.RES
T01.RDF: T01.ASM
	nasm -f rdf T01.ASM
T02.RDF: T02.ASM
	nasm -f rdf T02.ASM
T03.RDF: T03.ASM
	nasm -f rdf T03.ASM
clean:
	DEL *.RDF
	DEL T01.EXE
	DEL T03.EXE
	DEL T05.EXE
	DEL R01.RES
