	..\..\BIN\RLINK winpe /def=D01.DEF /o=DOSDLL.DLL D01.RDF
T01.EXE: T01.RDF T01.DEF ..\..\BIN\RLINK.EXE
	..\..\BIN\RLINK dospe /hx /def=T01.DEF /o=T01.EXE T01.RDF
D01.RDF: D01.ASM
	nasm -f rdf D01.ASM
T01.RDF: T01.ASM
	nasm -f rdf T01.ASM
clean:
	DEL *.RDF
	DEL DOSDLL.DLL
	DEL T01.EXE
