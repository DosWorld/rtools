	..\..\BIN\RLINK ne /def=T07.DEF /o=T07.EXE T07.RDF
T09.EXE: T09.RDF T09.DEF ..\..\BIN\RLINK.EXE
	..\..\BIN\RLINK ne /def=T09.DEF /o=T09.EXE T09.RDF
MLGEN.DEF: MYLIB.DLL ..\..\BIN\MKDEF.EXE
	..\..\BIN\MKDEF /o=MLGEN.DEF MYLIB.DLL
MLRT.DLL: T06.RDF MLGEN.DEF ..\..\BIN\RLINK.EXE
	..\..\BIN\RLINK ne /def=MLGEN.DEF /o=MLRT.DLL T06.RDF
T11.EXE: T11.RDF T11.DEF ..\..\BIN\RLINK.EXE
	..\..\BIN\RLINK ne /def=T11.DEF /o=T11.EXE T11.RDF
T11.OUT: T11.EXE ..\..\BIN\MKDEF.EXE
	..\..\BIN\MKDEF /o=T11.OUT T11.EXE
T06.RDF: T06.ASM
	nasm -f rdf T06.ASM
T07.RDF: T07.ASM
	nasm -f rdf T07.ASM
T08.RDF: T08.ASM
	nasm -f rdf T08.ASM
T09.RDF: T09.ASM
	nasm -f rdf T09.ASM
T11.RDF: T11.ASM
	nasm -f rdf T11.ASM
T12.DLL: T12A.RDF T12B.RDF T12C.RDF T12.DEF ..\..\BIN\RLINK.EXE
	..\..\BIN\RLINK ne /def=T12.DEF /o=T12.DLL T12A.RDF T12B.RDF T12C.RDF
T12A.RDF: T12A.ASM
	nasm -f rdf T12A.ASM
T12B.RDF: T12B.ASM
	nasm -f rdf T12B.ASM
T12C.RDF: T12C.ASM
	nasm -f rdf T12C.ASM
clean:
