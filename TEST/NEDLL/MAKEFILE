	..\..\BIN\RLINK ne /def=T06.DEF /o=MYLIB.DLL T06.RDF
MYLIB2.DLL: T08.RDF T08.DEF ..\..\BIN\RLINK.EXE
	..\..\BIN\RLINK ne /def=T08.DEF /o=MYLIB2.DLL T08.RDF
