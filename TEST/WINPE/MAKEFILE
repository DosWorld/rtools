all : T01.EXE MYDLL.DLL T03.EXE T04.EXE MLRT.DLL

T01.EXE: T01.RDF T01.DEF ..\..\BIN\RLINK.EXE
	..\..\BIN\RLINK winpe /def=T01.DEF /o=T01.EXE T01.RDF
MYDLL.DLL: T02.RDF T02.DEF ..\..\BIN\RLINK.EXE
	..\..\BIN\RLINK winpe /def=T02.DEF /o=MYDLL.DLL T02.RDF
T03.EXE: T03.RDF T03.DEF ..\..\BIN\RLINK.EXE
	..\..\BIN\RLINK winpe /def=T03.DEF /o=T03.EXE T03.RDF
T04.EXE: T04.RDF T04.DEF R01.RES ..\..\BIN\RLINK.EXE
	..\..\BIN\RLINK winpe /def=T04.DEF /res=R01.RES /o=T04.EXE T04.RDF
MLGEN.DEF: MYDLL.DLL ..\..\BIN\MKDEF.EXE
	..\..\BIN\MKDEF /o=MLGEN.DEF MYDLL.DLL
MLRT.DLL: T02.RDF MLGEN.DEF ..\..\BIN\RLINK.EXE
	..\..\BIN\RLINK winpe /def=MLGEN.DEF /o=MLRT.DLL T02.RDF
R01.RES: R01.ASM
	nasm -f bin R01.ASM -o R01.RES
T01.RDF: T01.ASM
	nasm -f rdf T01.ASM
T02.RDF: T02.ASM
	nasm -f rdf T02.ASM
T03.RDF: T03.ASM
	nasm -f rdf T03.ASM
T04.RDF: T04.ASM
	nasm -f rdf T04.ASM
clean:
	DEL *.RDF
	DEL T01.EXE
	DEL MYDLL.DLL
	DEL T03.EXE
	DEL T04.EXE
	DEL R01.RES
	DEL MLGEN.DEF
	DEL MLRT.DLL
