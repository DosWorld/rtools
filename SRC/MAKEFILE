all: RLINK.EXE RLIB.EXE RDFDUMP.EXE BIN2RDF.EXE MKDEF.EXE RESTUB.EXE

RLINK.EXE: RLINK.PAS RDFFMT.PAS RLO.PAS RLORDF.PAS RLOCOM.PAS RLOMZ.PAS RLOADAM.PAS RLOLE.PAS RLOQBE.PAS RLODEF.PAS RLONE.PAS RLOWPE.PAS EXE.PAS ELF.PAS
	TPC /M RLINK.PAS

RDFDUMP.EXE: RDFDUMP.PAS RDFFMT.PAS
	TPC /M RDFDUMP.PAS

RLIB.EXE: RLIB.PAS RDFFMT.PAS
	TPC /M RLIB.PAS

BIN2RDF.EXE: BIN2RDF.PAS RDFFMT.PAS
	TPC /M BIN2RDF.PAS

MKDEF.EXE: MKDEF.PAS EXE.PAS
	TPC /M MKDEF.PAS

RESTUB.EXE: RESTUB.PAS EXE.PAS
	TPC /M RESTUB.PAS

install: all
	COPY RLINK.EXE ..\BIN\
	COPY RLIB.EXE ..\BIN\
	COPY RDFDUMP.EXE ..\BIN\
	COPY BIN2RDF.EXE ..\BIN\
	COPY MKDEF.EXE ..\BIN\
	COPY RESTUB.EXE ..\BIN\

clean:
	DEL *.TPU
	DEL *.EXE
	DEL *.BAK
