all: RLINK.EXE RLIB.EXE RDFDUMP.EXE MORE
MORE: BIN2RDF.EXE MKDEF.EXE RESTUB.EXE

RLINK.EXE: RLINK.PAS RDFFMT.PAS LINK1 LINK2 LINK3 LINK4
	TPC /M RLINK.PAS
LINK1: RLO.PAS RLOSM.PAS RVALID.PAS RSTORE.PAS RLOMAP.PAS
LINK2: RLORDF.PAS RLOCOM.PAS RLOMZ.PAS RLOADAM.PAS RLOLE.PAS
LINK3: RLOQBE.PAS RLODEF.PAS RLONE.PAS RLOWPE.PAS RLOIMP.PAS
LINK4: EXE.PAS ELF.PAS

RDFDUMP.EXE: RDFDUMP.PAS RDFFMT.PAS RVALID.PAS
	TPC /M RDFDUMP.PAS

RLIB.EXE: RLIB.PAS RDFFMT.PAS RVALID.PAS RFILES.PAS
	TPC /M RLIB.PAS

BIN2RDF.EXE: BIN2RDF.PAS RDFFMT.PAS RFILES.PAS
	TPC /M BIN2RDF.PAS

MKDEF.EXE: MKDEF.PAS EXE.PAS RSTORE.PAS RFILES.PAS
	TPC /M MKDEF.PAS

RESTUB.EXE: RESTUB.PAS EXE.PAS RFILES.PAS
	TPC /M RESTUB.PAS

install: all
	COPY RLINK.EXE ..\BIN\
	COPY RLIB.EXE ..\BIN\
	COPY RDFDUMP.EXE ..\BIN\
	COPY BIN2RDF.EXE ..\BIN\
	COPY MKDEF.EXE ..\BIN\
	COPY RESTUB.EXE ..\BIN\

clean:
	DEL *.TPU
	DEL *.EXE
	DEL *.BAK
